# EU AI Operator's Desk — Environment Variables
# Browser-visible VITE_* values must never contain private provider secrets.

# Server-side AI providers (keep out of Vite/client bundles)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Authentication / external control-plane handoff
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
VITE_MINDREPLY_HANDOFF_URL=https://mind-reply.com

# API Endpoints
VITE_API_URL=http://localhost:5000

# Analytics (optional; use only public identifiers)
VITE_GA_ID=

# Feature flags
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_HARDWARE_OPTIMIZATION=false
VITE_ENABLE_REGIONAL_LOCALIZATION=false
VITE_ENABLE_MINDREPLY_HANDOFF=true

# Server environment
NODE_ENV=development
PORT=5000
