# EU AI Operator's Desk — Environment Variables

# API Keys
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Authentication (OAuth)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# API Endpoints
VITE_API_URL=http://localhost:5000

# Analytics (optional)
VITE_GA_ID=

# Feature flags
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_HARDWARE_OPTIMIZATION=false
VITE_ENABLE_REGIONAL_LOCALIZATION=false

# Server environment
NODE_ENV=development
PORT=5000
